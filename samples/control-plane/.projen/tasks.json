{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets"
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "integ": {
      "name": "integ",
      "description": "Run the deployment integration test in $AWS_REGION (deploys to the current AWS account, ~25 min)",
      "steps": [
        {
          "exec": "sh -c '[ -n \"$AWS_REGION\" ] || { echo \"Set AWS_REGION to the single Region to test in (e.g. export AWS_REGION=eu-central-1)\"; exit 1; }'"
        },
        {
          "exec": "sh -c 'AWS_DEFAULT_REGION=\"$AWS_REGION\" exec integ-runner --language typescript --parallel-regions \"$AWS_REGION\" --update-on-failed --force integ.tenant.ts'"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "exec": "smithy build"
        }
      ]
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "exec": "cdk synth --context vendorIdpIssuerUrl=https://build-placeholder.invalid --context vendorIdpAudience=build-placeholder --context cellDefinition='{\"source\":{\"type\":\"GITHUB\",\"location\":\"https://github.com/build-placeholder/build-placeholder.git\"},\"cellScripts\":{\"create\":\"scripts/sample-cell/create.sh\",\"update\":\"scripts/sample-cell/update.sh\",\"delete\":\"scripts/sample-cell/delete.sh\"},\"tenantScripts\":{\"create\":\"scripts/sample-tenant/create.sh\",\"update\":\"scripts/sample-tenant/update.sh\",\"delete\":\"scripts/sample-tenant/delete.sh\"},\"maxTenants\":10}'"
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "exec": "cdk synth -q --context vendorIdpIssuerUrl=https://build-placeholder.invalid --context vendorIdpAudience=build-placeholder --context cellDefinition='{\"source\":{\"type\":\"GITHUB\",\"location\":\"https://github.com/build-placeholder/build-placeholder.git\"},\"cellScripts\":{\"create\":\"scripts/sample-cell/create.sh\",\"update\":\"scripts/sample-cell/update.sh\",\"delete\":\"scripts/sample-cell/delete.sh\"},\"tenantScripts\":{\"create\":\"scripts/sample-tenant/create.sh\",\"update\":\"scripts/sample-tenant/update.sh\",\"delete\":\"scripts/sample-tenant/delete.sh\"},\"maxTenants\":10}'"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@types/jest,@types/node,esbuild,eslint-import-resolver-typescript,eslint-plugin-import,jest,projen,ts-jest,ts-node,typescript"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@aws-cdk/integ-runner",
            "@aws-cdk/integ-tests-alpha",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "aws-cdk",
            "aws-sdk-client-mock",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "jest",
            "jest-junit",
            "projen",
            "ts-jest",
            "ts-node",
            "typescript",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/client-sfn",
            "@aws-sdk/core",
            "@aws-sdk/lib-dynamodb",
            "@smithy/core",
            "@smithy/fetch-http-handler",
            "@smithy/node-http-handler",
            "@smithy/server-apigateway",
            "@smithy/server-common",
            "@smithy/types",
            "aws-cdk-lib",
            "cdk-nag",
            "constructs",
            "jose",
            "tslib",
            "ulid"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
